generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String
  passwordHash    String
  role            String            @default("viewer")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  industryReports IndustryReport[]
  authoredMemos   InvestmentMemo[]  @relation("MemoAuthor")
  marketOutlooks  MarketOutlook[]
  valuationModels  ValuationModel[]
  WatchlistItem   WatchlistItem[]
}

model Company {
  id              String            @id @default(cuid())
  name            String
  ticker          String            @unique
  exchange        String
  sector          String
  industry        String
  description     String?
  status          EntityStatus      @default(draft)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  attachments     Attachment[]
  reports         IndustryReport[]
  memos           InvestmentMemo[]
  outlooks        MarketOutlook[]
  valuationModels ValuationModel[]
  WatchlistItem   WatchlistItem[]
}

model InvestmentMemo {
  id                String         @id @default(cuid())
  companyId         String
  authorId          String?
  title             String
  slug              String         @unique
  recommendation    Recommendation
  targetPrice       Decimal        @db.Decimal(18, 4)
  currentPrice      Decimal        @db.Decimal(18, 4)
  expectedReturn    Decimal        @db.Decimal(10, 4)
  investmentHorizon String
  convictionLevel   Int
  executiveSummary  String
  thesis            String
  keyCatalysts      String
  keyRisks          String
  status            EntityStatus   @default(draft)
  publishedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  attachments       Attachment[]
  author            User?          @relation("MemoAuthor", fields: [authorId], references: [id])
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tags              MemoTag[]
}

model ValuationModel {
  id                  String       @id @default(cuid())
  companyId           String
  authorId            String?
  title               String
  slug                String       @unique
  currentSharePrice   Decimal      @db.Decimal(18, 4)
  revenue             Decimal      @db.Decimal(18, 4)
  revenueGrowth       Decimal      @db.Decimal(10, 4)
  ebitdaOrEbit        Decimal      @db.Decimal(18, 4)
  freeCashFlow        Decimal      @db.Decimal(18, 4)
  wacc                Decimal      @db.Decimal(10, 4)
  terminalGrowthRate  Decimal      @db.Decimal(10, 4)
  enterpriseValue     Decimal      @db.Decimal(18, 4)
  equityValue         Decimal      @db.Decimal(18, 4)
  sharesOutstanding   Decimal      @db.Decimal(18, 0)
  fairValue           Decimal      @db.Decimal(18, 4)
  upsideDownside      Decimal      @db.Decimal(10, 4)
  valuationConclusion String
  status              EntityStatus @default(draft)
  publishedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  attachments         Attachment[]
  author              User?        @relation(fields: [authorId], references: [id])
  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model IndustryReport {
  id                     String       @id @default(cuid())
  companyId              String?
  authorId               String?
  title                  String
  slug                   String       @unique
  executiveSummary       String
  overview               String
  marketSize             String
  tam                    String
  sam                    String
  som                    String
  growth                 String
  porterFiveForces       String
  valueChain             String
  competitors            String
  supplyChain            String
  demandDrivers          String
  technologyTrends       String
  regulation             String
  risks                  String
  investmentImplications String
  status                 EntityStatus @default(draft)
  publishedAt            DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  attachments            Attachment[]
  author                 User?        @relation(fields: [authorId], references: [id])
  company                Company?     @relation(fields: [companyId], references: [id])
}

model MarketOutlook {
  id                   String       @id @default(cuid())
  companyId            String?
  authorId             String?
  title                String
  slug                 String       @unique
  month                String
  executiveSummary     String
  federalReserve       String
  interestRates        String
  inflation            String
  gdp                  String
  employment           String
  geopolitics          String
  currencies           String
  commodities          String
  technology           String
  ai                   String
  semiconductors       String
  healthcare           String
  consumer             String
  financials           String
  marketValuation      String
  sectorOutlook        String
  portfolioPositioning String
  conclusion           String
  status               EntityStatus @default(draft)
  publishedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  attachments          Attachment[]
  author               User?        @relation(fields: [authorId], references: [id])
  company              Company?     @relation(fields: [companyId], references: [id])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String?
  createdAt DateTime  @default(now())
  memoTags  MemoTag[]
}

model MemoTag {
  id     String         @id @default(cuid())
  memoId String
  tagId  String
  memo   InvestmentMemo @relation(fields: [memoId], references: [id], onDelete: Cascade)
  tag    Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([memoId, tagId])
}

model Attachment {
  id                String           @id @default(cuid())
  companyId         String?
  memoId            String?
  industryReportId  String?
  marketOutlookId   String?
  valuationModelId  String?
  fileName          String
  fileType          String
  fileSize          Int
  url               String
  publicId          String
  createdAt         DateTime         @default(now())
  company           Company?         @relation(fields: [companyId], references: [id])
  industryReport    IndustryReport?  @relation(fields: [industryReportId], references: [id])
  marketOutlook     MarketOutlook?   @relation(fields: [marketOutlookId], references: [id])
  memo              InvestmentMemo?  @relation(fields: [memoId], references: [id])
  valuationModel    ValuationModel?  @relation(fields: [valuationModelId], references: [id])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WatchlistItem {
  id        String   @id
  userId    String
  companyId String
  createdAt DateTime @default(now())
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

enum EntityStatus {
  draft
  published
  archived
}

enum Recommendation {
  buy
  overweight
  hold
  underweight
  sell
}
