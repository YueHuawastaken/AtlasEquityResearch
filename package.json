{
  "name": "atlas-equity-research",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"server,client\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --workspace @atlas/client run dev",
    "dev:server": "npm --workspace @atlas/server run dev",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
